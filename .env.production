# Flowtaris AI - Production Environment Variables
# Add these to Vercel Project Settings > Environment Variables
# https://vercel.com/dashboard/flowtaris-ai/settings/environment-variables

# =============================================================================
# REQUIRED - Sanity CMS
# =============================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=s5kwr3ae
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=<from-sanity-manage>
SANITY_PREVIEW_SECRET=<generate-random-string>

# =============================================================================
# REQUIRED - Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=<from-supabase-dashboard>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from-supabase-dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from-supabase-dashboard>
SUPABASE_URL=<from-supabase-dashboard>

# =============================================================================
# REQUIRED - Resend Email
# =============================================================================
RESEND_API_KEY=<from-resend-dashboard>
RESEND_FROM_EMAIL=noreply@flowtaris.ai
RESEND_TO_EMAIL=leads@flowtaris.ai

# =============================================================================
# REQUIRED - Analytics
# =============================================================================
NEXT_PUBLIC_GA4_MEASUREMENT_ID=<from-google-analytics>
NEXT_PUBLIC_GTM_ID=<from-google-tag-manager>

# =============================================================================
# REQUIRED - Sentry
# =============================================================================
SENTRY_DSN=<from-sentry-dashboard>
SENTRY_ORG=<from-sentry-dashboard>
SENTRY_PROJECT=<from-sentry-dashboard>
SENTRY_AUTH_TOKEN=<from-sentry-dashboard>

# =============================================================================
# REQUIRED - App Config
# =============================================================================
NEXT_PUBLIC_APP_URL=https://flowtaris.ai
NEXT_PUBLIC_APP_NAME=Flowtaris AI
NODE_ENV=production

# =============================================================================
# OPTIONAL - Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_INNOVATION_LAB=true
NEXT_PUBLIC_ENABLE_ASSESSMENT_TOOL=true
NEXT_PUBLIC_ENABLE_ROI_CALCULATOR=true
NEXT_PUBLIC_ENABLE_INACTION_CALCULATOR=true

# =============================================================================
# VERCEL (Auto-populated by Vercel)
# =============================================================================
# VERCEL_URL=https://flowtaris.ai
# VERCEL_GIT_COMMIT_SHA=...
# VERCEL_ENV=production