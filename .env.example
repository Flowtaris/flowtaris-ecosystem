# =============================================================================
# FLOWTARIS AI — Environment Variables Template
# =============================================================================
# Copy to .env.local for local development (NEVER commit .env.local)
# Actual values go in Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# SANITY CMS (Required)
# -----------------------------------------------------------------------------
# Get from: sanity.io/manage → Project → API → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# API version (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token for preview mode (from Sanity → API → Tokens → "Viewer" token)
# Only needed for preview mode locally; Vercel Preview handles via Sanity webhook
SANITY_API_READ_TOKEN=skxxx_your_read_token_here

# Write token for webhooks (from Sanity → API → Tokens → "Editor" token)
# Used by Sanity webhook → Vercel revalidate
SANITY_API_WRITE_TOKEN=skxxx_your_write_token_here

# Preview secret for draft mode (generate a random string)
SANITY_PREVIEW_SECRET=your_random_preview_secret_here

# -----------------------------------------------------------------------------
# SUPABASE (Required)
# -----------------------------------------------------------------------------
# Get from: supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SECRET - server-side only, never in NEXT_PUBLIC_)
# Get from: supabase.com/dashboard → Project → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alias for server-side components
SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------------------------
# RESEND EMAIL (Required for lead notifications)
# -----------------------------------------------------------------------------
# Get from: resend.com/api-keys
RESEND_API_KEY=re_xxx_your_api_key_here

# From email (must be verified in Resend → Domains)
RESEND_FROM_EMAIL=Flowtaris AI <noreply@flowtaris.ai>

# Sales/alert emails (for high-score leads, demo requests)
RESEND_ALERTS_TO=sales@flowtaris.ai,partners@flowtaris.ai

# -----------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 (Required)
# -----------------------------------------------------------------------------
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING (Optional but recommended)
# -----------------------------------------------------------------------------
# Get from: sentry.io → Settings → Projects → DSN
SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx

# For source map upload in CI
SENTRY_ORG=your-org
SENTRY_PROJECT=flowtaris-ai
SENTRY_AUTH_TOKEN=sntrys_xxx

# -----------------------------------------------------------------------------
# VERCEL DEPLOYMENT (For CI/CD)
# -----------------------------------------------------------------------------
# Get from: vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
# Base URL (auto-set by Vercel, but useful for local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Flowtaris AI

# For production, Vercel sets this automatically to https://flowtaris.ai
# NODE_ENV=development (or production)

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features for gradual rollout
NEXT_PUBLIC_ENABLE_INNOVATION_LAB=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# -----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES (Local only - not used in production)
# -----------------------------------------------------------------------------
# Use mock data instead of Sanity (for offline development)
USE_MOCK_DATA=false

# Skip email sending in development
SKIP_EMAIL_IN_DEV=true