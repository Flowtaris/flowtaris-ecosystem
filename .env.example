# Flowtaris AI - Local Development Environment
# Copy this file to .env.local and fill in your values

# =============================================================================
# SANITY CMS
# =============================================================================
# Get from: https://www.sanity.io/manage/projects
NEXT_PUBLIC_SANITY_PROJECT_ID=5gbgq9zl
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# For preview mode (read/write)
# Get from: https://www.sanity.io/manage/projects/5gbgq9zl/api
SANITY_API_TOKEN=
SANITY_PREVIEW_SECRET=

# =============================================================================
# SUPABASE (Database, Auth, Realtime)
# =============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co

# =============================================================================
# RESEND (Transactional Email)
# =============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@flowtaris.ai
RESEND_TO_EMAIL=leads@flowtaris.ai

# =============================================================================
# VERCEL (Deployment)
# =============================================================================
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# =============================================================================
# ANALYTICS
# =============================================================================
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# =============================================================================
# SENTRY (Error Tracking)
# =============================================================================
# Get from: https://sentry.io/settings/
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Flowtaris AI
NODE_ENV=development